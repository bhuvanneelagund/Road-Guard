# Backend Environment Configuration
JWT_SECRET=roadguard_secure_jwt_secret_2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Leave blank for automatic SQLite Document Mode or provide MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/roadguard_ai?retryWrites=true&w=majority
MONGODB_URI=
DATABASE_NAME=roadguard_ai
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=backend/roadguard.db

# Storage
UPLOAD_DIR=backend/uploads
MAX_IMAGE_SIZE_MB=25
MAX_VIDEO_SIZE_MB=200

# AI Configuration
YOLO_MODEL_PATH=backend/app/ai/weights/road_damage_best.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
ENABLE_DEMO_FALLBACK=True
