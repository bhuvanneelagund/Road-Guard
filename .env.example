# ROADGUARD AI - Environment Configuration

# Backend Configuration
PORT=8000
HOST=0.0.0.0
JWT_SECRET=replace_with_secure_random_jwt_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Optional MongoDB Atlas connection string. If omitted, RoadGuard AI automatically runs in local SQLite document mode!
MONGODB_URI=
DATABASE_NAME=roadguard_ai
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=backend/roadguard.db

# AI Road Damage Pipeline
YOLO_MODEL_PATH=backend/app/ai/weights/road_damage_best.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
ENABLE_DEMO_FALLBACK=True

# File Uploads
UPLOAD_DIR=backend/uploads
MAX_IMAGE_SIZE_MB=25
MAX_VIDEO_SIZE_MB=200

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api
